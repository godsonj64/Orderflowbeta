STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=

# Only when the server does NOT run on Google Cloud in the same project as Firestore:
# the Firebase service-account key (JSON, or base64 of the JSON). Without database
# access the store runs in "basic mode" (cash orders only), see SETUP.md.
FIREBASE_SERVICE_ACCOUNT=

# Optional: comma-separated bootstrap admin emails (defaults to the ones in firestore.rules)
ADMIN_EMAILS=
